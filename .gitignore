# -------------------------------
# Expiry Finder .gitignore
# -------------------------------

# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Database files
db/

# Mobile tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build output
/target/

# Virtual machine crash logs
hs_err_pid*

# -------------------------------
# IDE-specific files
# -------------------------------

# IntelliJ IDEA / JetBrains
.idea/
*.iml
out/

# Eclipse
.project
.classpath
.settings/
bin/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# VS Code
.vscode/

# -------------------------------
# OS-specific files
# -------------------------------

# macOS
.DS_Store

# Windows
Thumbs.db